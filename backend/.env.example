# ==============================================================================
# Persona Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and provide your secrets.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Gemini LLM Configuration
# Required for live LLM mode. If left empty, backend can run in mock mode
# or fallback to client-side deterministic reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent Execution Mode: "gemini" or "mock"
# - "gemini": Executes Google ADK Agent with tool calls against catalog & cart services.
# - "mock": Returns 503 / mock events so client uses local deterministic pipeline.
AGENT_BACKEND=gemini

# Internal Shared Secret
# Secures server-to-server communication between Next.js API routes and FastAPI.
# Optional in local development; recommended in production.
AGENT_SHARED_SECRET=

# Environment
# "development" | "staging" | "production"
ENVIRONMENT=development

# Agent Guardrails & Rate Limiting
AGENT_MAX_MESSAGE_LENGTH=500
AGENT_RATE_LIMIT_PER_MINUTE=60
AGENT_TURN_TIMEOUT_SECONDS=30.0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chaos & Latency Simulation (Testing / Sandbox only)
# Set to 0.0 in normal operations.
PERSONA_FAILURE_RATE=0.0
PERSONA_LATENCY_MIN_MS=200
PERSONA_LATENCY_MAX_MS=600

# Logging Level
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
