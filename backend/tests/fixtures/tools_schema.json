{
  "tools": [
    {
      "name": "search_products",
      "description": "Search the catalog with structured filters. Returns matching products, best matches first.",
      "mutation": false
    },
    {
      "name": "get_product",
      "description": "Fetch one product with full specs and live stock.",
      "mutation": false
    },
    {
      "name": "compare_products",
      "description": "Compare 2–4 products attribute by attribute using catalog values only, with a grounded verdict.",
      "mutation": false
    },
    {
      "name": "check_stock",
      "description": "Check live stock for a product.",
      "mutation": false
    },
    {
      "name": "get_delivery_info",
      "description": "Delivery time and fee for a destination city.",
      "mutation": false
    },
    {
      "name": "add_to_cart",
      "description": "Add a product to the user's cart. The runtime always verifies with get_cart afterwards.",
      "mutation": true
    },
    {
      "name": "remove_from_cart",
      "description": "Remove a product line from the user's cart. The runtime always verifies with get_cart afterwards.",
      "mutation": true
    },
    {
      "name": "get_cart",
      "description": "Read the user's current cart.",
      "mutation": false
    }
  ],
  "sampleSummaries": [
    {
      "tool": "search_products",
      "output": {
        "total": 0,
        "searched": 12
      },
      "expected": "0 results of 12"
    },
    {
      "tool": "search_products",
      "output": {
        "total": 1,
        "searched": 12
      },
      "expected": "1 result of 12"
    },
    {
      "tool": "search_products",
      "output": {
        "total": 5,
        "searched": 12
      },
      "expected": "5 results of 12"
    },
    {
      "tool": "get_product",
      "output": {
        "brand": "Lenovo",
        "name": "IdeaPad Slim 5"
      },
      "expected": "Lenovo IdeaPad Slim 5"
    },
    {
      "tool": "compare_products",
      "output": {
        "productIds": [
          "a",
          "b"
        ],
        "winnerId": "a"
      },
      "expected": "2 products · winner found"
    },
    {
      "tool": "compare_products",
      "output": {
        "productIds": [
          "a",
          "b",
          "c"
        ],
        "winnerId": null
      },
      "expected": "3 products · close call"
    },
    {
      "tool": "check_stock",
      "output": {
        "productId": "p1",
        "inStock": true,
        "quantity": 4
      },
      "expected": "in stock (4)"
    },
    {
      "tool": "check_stock",
      "output": {
        "productId": "p1",
        "inStock": false,
        "quantity": 0
      },
      "expected": "out of stock"
    },
    {
      "tool": "get_delivery_info",
      "output": {
        "city": "Kathmandu",
        "days": "1-2 days"
      },
      "expected": "Kathmandu · 1-2 days"
    },
    {
      "tool": "add_to_cart",
      "output": {
        "cart": {}
      },
      "expected": "Added to cart, stock confirmed"
    },
    {
      "tool": "remove_from_cart",
      "output": {
        "cart": {}
      },
      "expected": "Removed from cart"
    },
    {
      "tool": "get_cart",
      "output": {
        "itemCount": 1,
        "subtotal": 120000
      },
      "expected": "1 item · NPR 1,20,000"
    },
    {
      "tool": "get_cart",
      "output": {
        "itemCount": 3,
        "subtotal": 450000
      },
      "expected": "3 items · NPR 4,50,000"
    }
  ],
  "errorSummaries": {
    "OUT_OF_STOCK": "out of stock",
    "NOT_FOUND": "not found",
    "TRANSIENT": "service unavailable",
    "INVALID_INPUT": "invalid request"
  },
  "transientErrorMessage": "Store service unavailable."
}