# ==============================================================================
# Persona Root / Frontend Environment Variables (.env.example)
# Copy this file to .env.local for local Next.js development.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# Backend FastAPI service URL (Docker container port 8080 or local)
BACKEND_URL=http://127.0.0.1:8080

# Agent mode: "mock" (deterministic client mock) or "gemini"
PERSONA_AGENT=mock

# Gemini API Key (optional for direct frontend execution; alternatively configured in backend/.env)
GEMINI_API_KEY=

# Internal shared secret matching AGENT_SHARED_SECRET in backend/.env
AGENT_SHARED_SECRET=

# Chaos testing headers (1 to allow simulated latency/errors in tests, 0 for production)
ALLOW_CHAOS_HEADERS=1
